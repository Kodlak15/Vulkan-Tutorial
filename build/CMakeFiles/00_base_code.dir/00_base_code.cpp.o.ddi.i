          m_library = dlopen( "libvulkan.so", 0x00002 | 0 );
          if ( !m_library )
          {
            m_library = dlopen( "libvulkan.so.1", 0x00002 | 0 );
          }



        }


        if ( !m_library )
        {

          throw std::runtime_error( "Failed to load vulkan library!" );
        }

      }

      DynamicLoader( DynamicLoader const & ) = delete;

      DynamicLoader( DynamicLoader && other ) noexcept : m_library( other.m_library )
      {
        other.m_library = nullptr;
      }

      DynamicLoader & operator=( DynamicLoader const & ) = delete;

      DynamicLoader & operator=( DynamicLoader && other ) noexcept
      {
        std::swap( m_library, other.m_library );
        return *this;
      }

      ~DynamicLoader() noexcept
      {
        if ( m_library )
        {

          dlclose( m_library );





        }
      }

      template <typename T>
      T getProcAddress( const char * function ) const noexcept
      {

        return (T)dlsym( m_library, function );





      }

      bool success() const noexcept
      {
        return m_library != nullptr;
      }

    private:

      void * m_library;





    };


