    class DynamicLoader
    {
    public:



      DynamicLoader( std::string const & vulkanLibraryName = {} )

      {
        if ( !vulkanLibraryName.empty() )
        {



          m_library = dlopen( vulkanLibraryName.c_str(), 0x00002 | 0 );



        }
        else
        {
